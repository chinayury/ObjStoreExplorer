# ObjStoreExplorer - 环境变量示例模板
# 用法: cp .env.example .env  然后填入真实值
# ⚠ .env 绝不入库 (见 .gitignore)

# ==================== 数据目录 ====================
# 重定向数据目录。留空则用程序所在目录下的 data/。
# 适用场景: 多实例并行 / 便携模式 (数据跟程序走 U 盘) / 只读目录规避。
# 目录内含: 加密主密钥 explorer.key、连接历史 config.db、日志、缓存、
#           Web 账号与会话库 web/web.db、会话签名密钥 web/secret.key。
OSE_DATA_DIR=

# ==================== Web 容器版 (v0.1.0 第二轮) ====================
# uvicorn worker 进程数 (Dockerfile CMD 读取, 默认 1)。
# 会话/连接/任务状态已外置 SQLite (data/web/web.db, WAL), 多 worker 可用。
# 调大前提: data/ 在持久卷上 (compose 默认满足); 注意事项见 README「多 worker 说明」。
WEB_WORKERS=1
